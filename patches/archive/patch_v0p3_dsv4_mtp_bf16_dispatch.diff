+        # Detect MTP layer: trunk has layers 0..num_hidden_layers-1; the
+        # MTP draft uses layer index == num_hidden_layers (61 for V4-Pro).
+        # MoE prefix looks like 'model.layers.<N>.ffn'; extract N via regex.
+        import re as _re
+        _is_mtp_layer = False
+        try:
+            _m = _re.search(r'\.layers\.(\d+)\.', prefix or '')
+            if _m:
+                _layer_idx = int(_m.group(1))
+                _n_hidden = int(getattr(config, 'num_hidden_layers', 10**9))
+                _is_mtp_layer = (_layer_idx >= _n_hidden)
+        except (ValueError, AttributeError, IndexError):
+            _is_mtp_layer = False
+        if _is_mtp_layer:
+            import json as _json
+            from pathlib import Path as _Path
+            try:
+                model_path = vllm_config.model_config.model
+                idx_path = _Path(model_path) / 'model.safetensors.index.json'
+                if idx_path.exists():
