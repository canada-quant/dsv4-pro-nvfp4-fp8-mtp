+                        # safely here because the trunk's MoEs were already
+                        # constructed (NVFP4 path captured the prior value);
+                        # only this MTP MoE picks up the override.
+                        try:
+                            vllm_config.kernel_config.moe_backend = 'triton'
+                            logging.getLogger('vllm').info(
+                                'DeepseekV4MoE: MTP layer overriding moe_backend -> triton'
